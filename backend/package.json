{
  "name": "job-portal-backend",
  "version": "1.0.0",
  "description": "REST API for the Responsive Job Portal (Node.js built-ins + node:sqlite, zero npm dependencies)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "migrate": "node --disable-warning=ExperimentalWarning src/scripts/migrate.js",
    "seed": "node --disable-warning=ExperimentalWarning src/scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/utils.test.js tests/api.test.js"
  }
}
