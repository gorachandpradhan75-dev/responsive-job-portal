# Copy this file to ".env" and change the values. NEVER commit the real .env file.

# --- Backend --------------------------------------------------------------
# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret
# Token lifetime: seconds, or a number with s/m/h/d (e.g. 3600, 30m, 12h, 7d)
JWT_EXPIRES_IN=1h
PORT=5000
# SQLite file path (relative paths are resolved from the backend/ folder)
DATABASE_PATH=./database/jobportal.db
NODE_ENV=development
# Allowed browser origins for CORS (comma separated, or *). Leave empty in production
# when the backend serves the built frontend itself (same origin).
CORS_ORIGIN=http://localhost:5173
# Set to "false" to stop the backend from serving the built frontend (dist/)
SERVE_FRONTEND=true

# --- Frontend (Vite) ------------------------------------------------------
# Only needed when the frontend is hosted separately from the API (build-time variable).
# Leave empty in development (Vite proxies /api) and for single-service deployment.
VITE_API_URL=
# Optional: where the Vite dev server proxies /api to (default http://localhost:$PORT)
# VITE_DEV_PROXY_TARGET=http://localhost:5000
